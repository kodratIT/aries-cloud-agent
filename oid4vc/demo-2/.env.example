# Public URLs served by Caddy. Point DNS for these hostnames to this machine or
# server, then let Caddy route them to the Docker services.
#
# issuer hostname  -> Caddy -> issuer:8082
# auth hostname    -> Caddy -> auth-server:9001
# demo hostname    -> Caddy -> demo-app:3000
OID4VCI_PUBLIC_URL=https://issuer.your-domain.example
AUTH_SERVER_PUBLIC_URL=https://auth.your-domain.example
DEMO_PUBLIC_URL=https://demo.your-domain.example
STATUS_LIST_PUBLIC_URI=https://issuer.your-domain.example/tenant/{tenant_id}/status/{list_number}
WEBVH_SERVER_URL=https://webvh.your-domain.example
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# Optional DIDComm/ACA-Py endpoint advertised by the issuer agent.
# Keep the internal default for this local OID4VCI demo unless you expose port 3000.
ISSUER_AGENT_ENDPOINT=http://issuer:3000

ADMIN_MANAGE_AUTH_TOKEN=adminsecrettoken
ADMIN_INTERNAL_AUTH_TOKEN=admininternaltoken
TENANT_INTERNAL_AUTH_TOKEN=admininternaltoken
TENANT_SECRET=tenantsecrettoken
POSTGRES_HOST_PORT=5433
