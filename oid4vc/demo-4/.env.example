# Public URLs are routed by Dokploy. Configure each hostname in Dokploy
# for the Compose service and internal port shown below.
#
# issuer hostname -> issuer:8082
# auth hostname   -> auth-server:9001
# demo hostname   -> demo-app:3000
OID4VCI_PUBLIC_URL=https://agent-one.identitas.site
AUTH_SERVER_PUBLIC_URL=https://auth-one.identitas.site
DEMO_PUBLIC_URL=https://demo-one.identitas.site
STATUS_LIST_PUBLIC_URI=https://agent-one.identitas.site/tenant/{tenant_id}/status/{list_number}
WEBVH_SERVER_URL=https://webvh-one.identitas.site

# Optional DIDComm/ACA-Py endpoint advertised by the issuer agent.
# Keep the internal default for this local OID4VCI demo unless you expose port 3000.
ISSUER_AGENT_ENDPOINT=http://issuer:3000

ADMIN_MANAGE_AUTH_TOKEN=adminsecrettoken
ADMIN_INTERNAL_AUTH_TOKEN=admininternaltoken
TENANT_INTERNAL_AUTH_TOKEN=admininternaltoken
TENANT_SECRET=tenantsecrettoken
POSTGRES_HOST_PORT=5433
